{
  "data_dir": "~/.trustwatch",

  "camera": {
    "device_index": 0,
    "warmup_frames": 5,
    "width": 0,
    "height": 0
  },

  "motion": {
    "min_area": 1500,
    "sensitivity": 25,
    "cooldown_seconds": 20,
    "consecutive_frames": 2,
    "poll_interval": 0.1
  },

  "screen": {
    "enabled": true,
    "monitor": 0,
    "max_width": 1280
  },

  "guard": {
    "poll_interval": 2.0,
    "capture_on_start": true,
    "capture_on_wake": true,
    "wake_gap_seconds": 30.0,
    "capture_on_interaction": true,
    "interaction_idle_threshold": 3.0,
    "interaction_cooldown": 90.0,
    "capture_on_usb_change": true,
    "log_activity": true
  },

  "notifier": {
    "desktop": true,

    "telegram_token": "",
    "telegram_chat_id": "",

    "email_enabled": false,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587,
    "smtp_user": "you@example.com",
    "smtp_password": "",
    "email_to": "you@example.com",

    "webhook_url": ""
  }
}
